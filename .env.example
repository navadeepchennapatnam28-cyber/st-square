# ST² Student Growth Hub API configuration
# In DEMO mode (default), local mock data and localStorage are used.
# When connected to a real backend, set this URL and switch mode in Settings.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ENABLE_API_MODE=false

# Supabase Client Credentials (Client-side)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side AI API Keys (SUPABASE SECRETS / SERVER ONLY - DO NOT EXPOSE TO CLIENT)
# Set via: supabase secrets set GEMINI_API_KEY=your_key or OPENAI_API_KEY=your_key
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Custom AI Endpoint override if self-hosting
VITE_MOCK_INTERVIEW_AI_ENDPOINT=
